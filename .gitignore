# ==========================================
# Root & Environment Variables
# ==========================================
.env
.env.*
!.env.example
*.local

# IDEs & Editors
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# Docker
.dockerignore
# Optional: Ignore local docker-compose overrides if you use them
# docker-compose.override.yml


# ==========================================
# Frontend: React (`client/`)
# ==========================================
client/node_modules/
client/build/
client/dist/
client/out/

# Logs & Debugging
client/npm-debug.log*
client/yarn-debug.log*
client/yarn-error.log*
client/pnpm-debug.log*

# Testing & Coverage
client/coverage/
client/.nyc_output/

# Cache
client/.eslintcache
client/.parcel-cache/
client/.next/


# ==========================================
# Backend: Django (`server/`)
# ==========================================
# Python Bytecode & Cache
server/__pycache__/
server/*/__pycache__/
server/*/*/__pycache__/
*.py[cod]
*$py.class
server/.pytest_cache/
server/.coverage
server/htmlcov/

# Virtual Environments (in case dev work happens outside Docker)
server/env/
server/venv/
server/ENV/
server/env.bak/
server/venv.bak/

# Django Database & Media
# (Uncomment db.sqlite3 if using SQLite locally outside Docker)
server/*.sqlite3
server/*.sqlite3-journal
server/media/
server/staticfiles/
!server/staticfiles/.gitkeep

# Django Logs
server/*.log
